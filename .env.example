# =========================================================
# CALL ELITE BACKEND — ENVIRONMENT VARIABLES (EXAMPLE)
# =========================================================
# Copy this file to ".env" for local emulator use:
#   cp .env.example .env
#
# In production, DO NOT rely on a committed .env file.
# Set these as Firebase Functions config / secrets instead:
#   firebase functions:secrets:set SMTP_PASSWORD
#   firebase functions:config:set app.allowed_origin="https://yourdomain.com"
#
# NEVER commit a real ".env" file. NEVER place any of these
# values inside index.html, script.js, CSS, or manifest.json.
# =========================================================

# -----------------------------------------------------
# FIREBASE (client-side config — safe to expose publicly,
# but keep it OUT of committed source anyway per project
# convention; inject at build/deploy time)
# -----------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------
# FIREBASE ADMIN (server-side only — Cloud Functions
# already run with implicit admin credentials; these are
# only needed for local emulation with a service account)
# -----------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# -----------------------------------------------------
# CORS / ALLOWED ORIGIN(S)
# -----------------------------------------------------
ALLOWED_ORIGIN=https://www.callelite.example.com
ALLOWED_ORIGIN_STAGING=https://staging.callelite.example.com

# -----------------------------------------------------
# EMAIL NOTIFICATIONS (choose ONE provider and fill only
# that section; leave the rest blank). Nothing is sent
# unless these are configured — the backend degrades to
# "store only, no email" automatically when they're empty.
# -----------------------------------------------------

# Option A: SMTP (e.g. Zoho Mail, Gmail Workspace, SES SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM_EMAIL=no-reply@callelite.example.com
NOTIFY_TO_EMAIL=info@callelite.com

# -----------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------
CONTACT_RATE_LIMIT_WINDOW_MIN=15
CONTACT_RATE_LIMIT_MAX=5
NEWSLETTER_RATE_LIMIT_WINDOW_MIN=15
NEWSLETTER_RATE_LIMIT_MAX=5

# -----------------------------------------------------
# GOOGLE ANALYTICS (frontend) — replace the placeholder
# only when a real Measurement ID has been issued.
# -----------------------------------------------------
GA_MEASUREMENT_ID=YOUR_GA_MEASUREMENT_ID

# -----------------------------------------------------
# GOOGLE SEARCH CONSOLE (frontend meta verification tag)
# -----------------------------------------------------
GOOGLE_SITE_VERIFICATION=YOUR_SEARCH_CONSOLE_VERIFICATION_CODE
