rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Leads (contact/quote form submissions).
    // Writes only ever happen server-side via the Admin SDK inside
    // Cloud Functions, which bypasses these rules entirely — so
    // "allow write" here is intentionally false for ALL clients.
    // Reads are restricted to authenticated admin users only.
    match /leads/{leadId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Newsletter subscribers — same pattern: server writes only,
    // admin-only reads.
    match /newsletter_subscribers/{subscriberId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin user profiles (for role lookups). Users may read their
    // own profile; nothing is publicly writable.
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
