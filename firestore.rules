rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // RC CALL ELITE - WEBSITE LEADS
    // ==========================================
    match /leads/{leadId} {

      // Only authenticated admins can read leads.
      allow read: if isAdmin();

      // Website visitors can create new leads.
      allow create: if
        request.resource.data.keys().hasOnly([
          'service',
          'city',
          'name',
          'phone',
          'message',
          'source',
          'createdAt'
        ])
        && request.resource.data.service is string
        && request.resource.data.service.size() > 0
        && request.resource.data.service.size() <= 100
        && request.resource.data.city is string
        && request.resource.data.city.size() > 0
        && request.resource.data.city.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 30
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1000
        && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time;

      // Nobody can modify or delete leads from the website.
      allow update, delete: if false;
    }


    // ==========================================
    // NEWSLETTER SUBSCRIBERS
    // ==========================================
    match /newsletter_subscribers/{subscriberId} {

      // Only authenticated admins can read.
      allow read: if isAdmin();

      // Website cannot write here yet.
      allow write: if false;
    }


    // ==========================================
    // ADMIN USERS
    // ==========================================
    match /admins/{userId} {

      // User can read their own admin profile.
      allow read: if request.auth != null &&
        request.auth.uid == userId;

      // Nobody can modify admin profiles.
      allow write: if false;
    }


    // ==========================================
    // DEFAULT SECURITY
    // ==========================================
    // Everything else is completely blocked.
    match /{document=**} {
      allow read, write: if false;
    }


    // ==========================================
    // ADMIN CHECK
    // ==========================================
    function isAdmin() {
      return request.auth != null &&
        exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        );
    }
  }
}
