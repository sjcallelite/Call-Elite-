{
  "name": "callelite-backend",
  "description": "Backend (Firebase Cloud Functions) for the RC Call Elite website: contact form, newsletter, lead storage.",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore,hosting",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.3.1",
    "firebase-functions": "^5.0.1",
    "helmet": "^7.1.0",
    "nodemailer": "^6.9.14",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "firebase-functions-test": "^3.3.0"
  }
}
